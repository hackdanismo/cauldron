```gitignore
# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript cache
*.tsbuildinfo

# Test coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# Editor settings
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
```